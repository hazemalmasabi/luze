{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
<header data-testid="store-header" class="store-header lds-store-header">
    <div id="mainnav" class="main-nav-container lds-main-nav">
        <div class="inner w-full">
            <div class="container lds-header-grid">
                <div class="lds-header-start">
                    <a data-testid="store-header-mobile-toggle"
                       class="lds-menu-toggle mburger mburger--collapse lg:hidden"
                       href="#mobile-menu"
                       aria-label="{{ language.code == 'ar' ? 'فتح القائمة' : 'Open menu' }}">
                        <i class="sicon-menu" aria-hidden="true"></i>
                    </a>
                    <custom-main-menu></custom-main-menu>
                </div>

                <a data-testid="store-header-logo" class="navbar-brand lds-brand" href="{{ store.url }}">
                    <img fetchpriority="high" width="100%" height="100%" loading="eager"
                         src="{{ store.logo|cdn(175) }}" alt="{{ store.name }}">
                    {% if is_page('index') %}
                        <h1 class="sr-only">{{ store.name }}</h1>
                    {% else %}
                        <h2 class="sr-only">{{ store.name }}</h2>
                    {% endif %}
                </a>

                <div class="lds-header-tools">
                    {% if store.scope %}
                        <button class="lds-icon-button lds-scope-button"
                                type="button"
                                aria-label="{{ store.scope.name }}"
                                title="{{ store.scope.name }}"
                                onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                            <i class="sicon-location" aria-hidden="true"></i>
                            <span>{{ store.scope.name }}</span>
                        </button>
                    {% endif %}

                    <salla-search data-testid="store-header-search" class="lds-header-search" placeholder oval height="44"></salla-search>

                    {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                        <salla-localization-modal data-testid="store-header-localization" class="lds-localization" show-trigger></salla-localization-modal>
                    {% endif %}

                    <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>

                    <salla-cart-summary data-testid="store-header-cart" class="lds-cart-summary">
                        <i slot="icon" class="header-btn__icon icon sicon-shopping-bag" aria-hidden="true"></i>
                    </salla-cart-summary>
                </div>
            </div>
        </div>
    </div>
</header>
