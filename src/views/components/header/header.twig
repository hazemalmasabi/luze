{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}
<header data-testid="store-header" class="store-header">
  {# Bullet Delivery tag — mobile #}
  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>

  {# Top Nav (Slim & Clean Announcement Bar) #}
  <div class="top-navbar text-xs">
    <div class="container flex justify-between items-center py-1">
      <div class="flex items-center gap-3">
          {# Footer Menu / Important links #}
          {% if important_links %}
            <salla-menu data-testid="store-header-topnav" source="footer" topnav></salla-menu>
          {% endif %}

          {# Bullet Delivery tag — desktop #}
          <div class="hidden lg:block">
            <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
          </div>

          {# Scopes | Branches #}
          {% if store.scope %}
              <button class="btn--rounded-gray text-xs"
                      onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                  <i class="sicon-location rtl:ml-1 ltr:mr-1"></i> {{ store.scope.name }}
              </button>
          {% endif %}
      </div>

      <div class="flex items-center gap-3">
          <salla-contacts data-testid="store-header-contacts" is-header></salla-contacts>
      </div>
    </div>
  </div>

  {# Main Nav: Store Name (Text Logo) + Menu + Actions Group #}
  <div id="mainnav" class="main-nav-container shadow-sm bg-white flex items-center py-2">
      <div class="inner bg-inherit w-full">
          <div class="container">
              <div class="flex items-center justify-between gap-4 relative">
                  
                  {# Right / Start: Mobile Toggle & Store Name as Text (No Image Logo) #}
                  <div class="flex items-center gap-3 shrink-0">
                      <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse leading-none" href="#mobile-menu" aria-label="Open-menu">
                        <i class="sicon-menu text-primary text-2xl"></i>
                      </a>
                      <a data-testid="store-header-logo" class="navbar-brand text-2xl md:text-3xl font-bold tracking-wider hover:opacity-80 transition-opacity whitespace-nowrap" href="{{ store.url }}">
                          <span class="store-name-wordmark" style="font-family: var(--font-serif, 'Playfair Display', serif); font-size: 1.65rem; font-weight: 700; color: var(--color-text, #2E2A24); letter-spacing: -0.02em;">{{ store.name }}</span>
                          {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                          {% else %}
                            <h2 class="sr-only">{{ store.name }}</h2>
                          {% endif %}
                      </a>
                  </div>

                  {# Center: Main Menu Navigation #}
                  <div class="hidden lg:flex items-center justify-center flex-1 overflow-hidden px-4">
                      <custom-main-menu></custom-main-menu>
                  </div>

                  {# Left / End: Action Buttons Group (Search + Language + User + Cart) #}
                  <div class="flex items-center justify-end gap-3 shrink-0">
                      {# Search Bar #}
                      <div class="header-search hidden sm:block w-44 md:w-56">
                        <salla-search data-testid="store-header-search" inline oval height="36"></salla-search>
                      </div>

                      {# Language & Currency #}
                      {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                          <div class="header-buttons">
                              <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
                          </div>
                      {% endif %}

                      {# User Profile #}
                      <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>

                      {# Cart Summary #}
                      <salla-cart-summary data-testid="store-header-cart" class="header-cart-btn">
                        <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
                      </salla-cart-summary>
                  </div>

              </div>
          </div>
      </div>
  </div>
</header>
